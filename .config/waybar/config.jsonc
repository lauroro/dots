{
    "position": "top",
    "layer": "top",
    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "tray",
        "mpris",
        "idle_inhibitor",
        "network",
        "battery",
        "backlight",
        "wireplumber",
        "clock"
    ],
    //
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶 on ",
            "deactivated": "󰛊 off"
        }
    },
    //
    "tray": {
        "icon-size": 16,
        "spacing": 0
    },
    //
    "battery": {
        "states": {
            //"good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-alt": "{icon} {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": ""
    },
    //
    "clock": {
        "locale": "it_IT.UTF-8",
        "format": "{:L%a %d %b, %R}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "months": "<span><b>{}</b></span>",
                "weekdays": "<span><b>{}</b></span>",
                "today": "<span><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode"
        },
        "tooltip": true
    },
    //
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": " Offline",
        "tooltip-format-wifi": "{essid} | Signal: {signalStrength}% | Download: {bandwidthDownBits}, Upload: {bandwidthUpBits}"
    },
    //	
    "wireplumber": {
        "tooltip": false,
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 1,
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        }
    },
    //
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "tooltip": false
    },
    //
    "mpris": {
        "title-len": 15,
        "ellipsis": "…",
        "format": "{status_icon} {player_icon}",
        "player-icons": {
            "default": "Player",
            "spotify": "Spotify",
            "firefox": "Firefox"
        },
        "status-icons": {
            "playing": "",
            "paused": "",
            "stopped": ""
        },
        "tooltip-format": "{player_icon} : {title} - by: {artist} - album: {album}",
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl previous",
        "on-click-right": "playerctl next"
    }
}
