// @gohan:start
configuration {  
    show-icons: false;  
    font: "Iosevka Nerd Font Mono 11";  
    drun-match-fields: "name,generic,comment,categories,keywords";  
    terminal: "alacritty -e";  
    location: 0;  

    drun {  
        display-name: ">";  
    }
}  
  
* {  
    background: #181a1f;  
    text: #a9b7c2;  
    border: #a9b7c2;  
}  
  
window {  
    width: 350;  
    anchor: center;  
    border-radius: 2px;  
    border: 1px;  
}  
  
listview {  
    scrollbar: false;  
}  
  
element normal.normal {  
    background-color: #181a1f;  
    text-color: #a9b7c2;  
}  
  
element alternate.normal {  
    background-color: #181a1f;  
    text-color: #a9b7c2;  
}  
  
element selected.normal {  
    background-color: #303843;  
    text-color: #a9b7c2;  
}  
  
element-text {  
    text-color: inherit;  
}  
  
entry {  
    text-color: #a9b7c2;  
    placeholder-color: #a9b7c2;  
    placeholder: "";  
}  
  
prompt {  
    text-color: #a9b7c2;  
}
// @gohan:end
